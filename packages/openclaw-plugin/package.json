{
  "name": "@jarvis/openclaw-plugin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Jarvis for OpenClaw: trade on-chain from chat. Talks to the local Jarvis engine; never holds keys.",
  "main": "./dist/index.js",
  "files": [
    "dist/",
    "skills/",
    "openclaw.plugin.json"
  ],
  "scripts": {
    "gen-schema": "node scripts/gen-plan-schema.mjs"
  },
  "dependencies": {
    "typebox": "1.3.34"
  },
  "devDependencies": {
    "@jarvis/core": "0.1.0",
    "@jarvis/engine": "0.1.0",
    "openclaw": "2026.10.5",
    "zod": "^4.1.0"
  },
  "peerDependencies": {
    "openclaw": ">=2026.10.5"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.10.5",
      "minGatewayVersion": "2026.10.5"
    },
    "build": {
      "openclawVersion": "2026.10.5",
      "pluginSdkVersion": "2026.10.5"
    }
  }
